# Allowlist: ignore everything, then opt files in.
# New files (auth, caches, sessions, logs) stay out of git by default.
/*
!/.gitignore
!/README.md
!/docs/
!/Brewfile

!/agent/
/agent/*
!/agent/AGENTS.md
!/agent/settings.json
!/agent/pi-fff.json
!/agent/pi-atelier.json
!/agent/extensions/
!/agent/skills/

# Regenerated by `herdr integration install pi`
/agent/extensions/herdr-agent-state.ts

.DS_Store
*.lock

# Per-workspace Atlassian facts; belong in each project, not here
/agent/skills/atlassian-cli/references/workspace.md
